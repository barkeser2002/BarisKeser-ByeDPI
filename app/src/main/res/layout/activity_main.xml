<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/th_bg"
    android:fitsSystemWindows="true"
    tools:context=".activities.MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== HOME ===== -->
        <ScrollView
            android:id="@+id/home_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/th_bg"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <!-- Wordmark -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ByeDPI"
                    android:textSize="34sp"
                    android:textColor="@color/th_text1"
                    android:fontFamily="@font/grenze_gotisch"
                    app:fontFamily="@font/grenze_gotisch"
                    tools:ignore="HardcodedText" />

                <!-- Brass caps label with hairline -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/th_connection_label"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"
                        android:textColor="@color/th_brass" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:alpha="0.6"
                        android:background="@color/th_brass" />
                </LinearLayout>

                <!-- Connect button with ring -->
                <FrameLayout
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="36dp">

                    <View
                        android:id="@+id/status_ring"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:background="@drawable/shape_ring"
                        android:backgroundTint="@color/th_text3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/status_button"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:letterSpacing="0.01"
                        app:cornerRadius="90dp"
                        app:backgroundTint="@color/th_red"
                        tools:text="@string/vpn_connect" />
                </FrameLayout>

                <!-- Status chip -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/shape_chip"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/status_dot"
                        android:backgroundTint="@color/th_text3" />

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="15sp"
                        android:textColor="@color/th_text1"
                        tools:text="@string/vpn_disconnected" />
                </LinearLayout>

                <!-- Proxy address -->
                <TextView
                    android:id="@+id/proxy_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/th_text2"
                    tools:text="127.0.0.1:1080" />

                <!-- Info card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    app:cardBackgroundColor="@color/th_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/th_hairline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/info_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="@color/th_text1"
                            tools:text="Mod: VPN" />

                        <TextView
                            android:id="@+id/info_dns"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="14sp"
                            android:textColor="@color/th_text2"
                            tools:text="DNS: 1.1.1.1" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- ===== ABOUT ===== -->
        <ScrollView
            android:id="@+id/about_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@color/th_bg"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="28dp">

                <ImageView
                    android:id="@+id/app_logo"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="16dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_logo_shield" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ByeDPI"
                    android:textSize="40sp"
                    android:textColor="@color/th_text1"
                    android:fontFamily="@font/grenze_gotisch"
                    app:fontFamily="@font/grenze_gotisch"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/about_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/th_brass"
                    tools:text="2.0.0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/about_tagline"
                    android:textSize="15sp"
                    android:textColor="@color/th_text1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/about_engine"
                    android:textSize="13sp"
                    android:textColor="@color/th_text2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/about_source"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textAllCaps="false"
                    android:text="@string/source_code_link"
                    android:textColor="@color/th_text1"
                    app:strokeColor="@color/th_text3"
                    app:strokeWidth="1dp"
                    app:iconTint="@color/th_text1"
                    app:icon="@drawable/ic_github_36" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/about_docs"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAllCaps="false"
                    android:text="@string/documentation"
                    android:textColor="@color/th_text1"
                    app:strokeColor="@color/th_text3"
                    app:strokeWidth="1dp"
                    app:iconTint="@color/th_text1"
                    app:icon="@drawable/ic_pref_code" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/th_hairline" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/th_surface"
        app:itemIconTint="@color/th_text2"
        app:itemTextColor="@color/th_text2"
        app:menu="@menu/bottom_nav" />

</LinearLayout>
