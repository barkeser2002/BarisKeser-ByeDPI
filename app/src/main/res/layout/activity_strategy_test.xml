<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/th_bg"
    android:orientation="vertical"
    tools:context=".activities.StrategyTestActivity">

    <!-- Everything above the Apply button scrolls, so in short windows (split screen,
         landscape with the keyboard open) the Apply button stays reachable. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/st_hint"
                android:textColor="@color/th_text2"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/host_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@color/th_surface"
                android:hint="@string/st_host_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:padding="14dp"
                android:text="discord.com"
                android:textColor="@color/th_text1"
                android:textColorHint="@color/th_text3"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:text="@string/st_start"
                android:textAllCaps="false"
                android:textColor="@color/th_text1"
                android:textSize="16sp"
                app:backgroundTint="@color/th_red"
                app:cornerRadius="14dp" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/st_idle"
                android:textColor="@color/th_text2"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="1"
                android:progress="0"
                android:progressBackgroundTint="@color/th_hairline"
                android:progressTint="@color/th_red" />

            <TextView
                android:id="@+id/progress_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:text="@string/st_progress"
                android:textColor="@color/th_text3"
                android:textSize="12sp"
                tools:text="0 / 9" />

            <LinearLayout
                android:id="@+id/results_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/apply_button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:enabled="false"
        android:minHeight="52dp"
        android:text="@string/st_apply"
        android:textAllCaps="false"
        android:textColor="@color/th_bg"
        android:textSize="16sp"
        app:backgroundTint="@color/th_brass"
        app:cornerRadius="14dp" />
</LinearLayout>
