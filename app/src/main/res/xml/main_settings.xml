<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:tag="main_settings">

    <androidx.preference.PreferenceCategory
        android:title="@string/boot_category">

        <SwitchPreference
            android:key="auto_connect_boot"
            android:icon="@drawable/ic_pref_shield"
            android:title="@string/boot_title"
            android:summary="@string/boot_summary"
            android:defaultValue="false" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/general_category">

        <DropDownPreference
            android:key="byedpi_mode"
            android:icon="@drawable/ic_pref_mode"
            android:title="@string/mode_setting"
            android:entries="@array/byedpi_modes"
            android:entryValues="@array/byedpi_modes_entries"
            android:defaultValue="vpn"
            app:useSimpleSummaryProvider="true" />

        <com.takisoft.preferencex.EditTextPreference
            android:key="dns_ip"
            android:icon="@drawable/ic_pref_dns"
            android:title="@string/dbs_ip_setting"
            android:defaultValue="1.1.1.1"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:key="split_tunnel"
            android:icon="@drawable/ic_pref_mode"
            android:title="@string/split_title"
            android:summary="@string/split_summary">
            <intent
                android:targetPackage="com.bariskeser.byedpi"
                android:targetClass="com.bariskeser.byedpi.activities.AppSelectActivity" />
        </Preference>

        <SwitchPreference
            android:key="ipv6_enable"
            android:icon="@drawable/ic_pref_ipv6"
            android:title="@string/ipv6_setting"
            android:defaultValue="false" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/byedpi_category">

        <DropDownPreference
            android:key="turkey_preset"
            android:icon="@drawable/ic_pref_preset"
            android:title="@string/turkey_preset_setting"
            android:entries="@array/turkey_presets"
            android:entryValues="@array/turkey_presets_values"
            android:defaultValue="--split 1 --disorder 3+s --mod-http=h,d --auto=torst --tlsrec 1+s"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:key="strategy_test"
            android:icon="@drawable/ic_pref_tune"
            android:title="@string/st_title"
            android:summary="@string/st_summary">
            <intent
                android:targetPackage="com.bariskeser.byedpi"
                android:targetClass="com.bariskeser.byedpi.activities.StrategyTestActivity" />
        </Preference>

        <SwitchPreference
            android:key="byedpi_enable_cmd_settings"
            android:icon="@drawable/ic_pref_terminal"
            android:title="@string/use_command_line_settings"
            android:defaultValue="false" />

        <Preference
            android:key="byedpi_ui_settings"
            android:icon="@drawable/ic_pref_tune"
            android:title="@string/ui_editor"
            app:useSimpleSummaryProvider="true"
            app:fragment="com.bariskeser.byedpi.fragments.ByeDpiUISettingsFragment" />

        <Preference
            android:key="byedpi_cmd_settings"
            android:icon="@drawable/ic_pref_code"
            android:title="@string/command_line_editor"
            app:useSimpleSummaryProvider="true"
            app:fragment="com.bariskeser.byedpi.fragments.ByeDpiCommandLineSettingsFragment" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/about_category">

        <Preference
            android:key="version"
            android:icon="@drawable/ic_pref_info"
            android:title="@string/version"
            app:useSimpleSummaryProvider="true"
            tools:summary="1.0.0" />

        <Preference
            android:key="source_code"
            android:icon="@drawable/ic_github_36"
            android:title="@string/source_code_link">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/barkeser2002/BarisKeser-ByeDPI" />
        </Preference>

    </androidx.preference.PreferenceCategory>

</PreferenceScreen>
