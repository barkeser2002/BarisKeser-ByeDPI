<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (Android 12+). The VPN disclosure consent is kept in its own
   file and is never backed up or transferred, so a restored device shows the
   disclosure again before the VPN can start.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vpn_consent.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vpn_consent.xml"/>
    </device-transfer>
</data-extraction-rules>
