<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 24-30 (full-data backup). The VPN disclosure consent is kept
   in its own file and is excluded so a restored device shows the disclosure again.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="vpn_consent.xml"/>
</full-backup-content>
