<resources>
    <!-- Dark brand palette. Overrides only the Base; Theme.ByeDPI (values/ and values-v35)
         inherits from this Base in night mode. -->
    <style name="Theme.ByeDPI.Base" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#23305C</item>
        <item name="colorPrimaryVariant">#161E3D</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">#FF7A5C</item>
        <item name="colorSecondaryVariant">#E5522F</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
</resources>
