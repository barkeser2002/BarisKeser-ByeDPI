<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same dark palette as values/themes.xml: the app is always dark. -->
    <style name="Theme.ByeDPI.Base" parent="Theme.MaterialComponents">
        <item name="colorPrimary">@color/th_red</item>
        <item name="colorPrimaryVariant">@color/th_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/th_brass</item>
        <item name="colorSecondaryVariant">@color/th_brass</item>
        <item name="colorOnSecondary">@color/th_bg</item>
        <item name="colorSurface">@color/th_surface</item>
        <item name="colorOnSurface">@color/th_text1</item>
        <item name="colorOnBackground">@color/th_text1</item>
        <item name="colorControlNormal">@color/th_text2</item>
        <item name="colorControlActivated">@color/th_red</item>
        <item name="android:colorBackground">@color/th_bg</item>
        <item name="android:windowBackground">@color/th_bg</item>
        <item name="android:statusBarColor">@color/th_bg</item>
        <item name="android:navigationBarColor">@color/th_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/th_text1</item>
        <item name="android:textColorSecondary">@color/th_text2</item>
        <item name="actionBarStyle">@style/Widget.ByeDPI.ActionBar</item>
    </style>
</resources>
