<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher foreground. The 48-unit shield is scaled 1.25x (to 60 units)
     and offset by 24 so it sits centred in the 66dp safe zone of the 108dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="24"
        android:translateY="24"
        android:scaleX="1.25"
        android:scaleY="1.25">

        <path
            android:fillColor="#0E1017"
            android:strokeColor="#C8A45A"
            android:strokeWidth="1.5"
            android:pathData="M24,2.5 L43,10 L43,22.5 C43,34.1 35.1,42.5 24,46.5 C12.9,42.5 5,34.1 5,22.5 L5,10 Z" />

        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF453A"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M16,21 L32,21 M19.5,21 L19.5,30.5 M28.5,21 L28.5,30.5" />

        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF453A"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M13.5,27.5 L34.5,13" />
    </group>
</vector>
