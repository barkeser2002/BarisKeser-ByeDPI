<?xml version="1.0" encoding="utf-8"?>
<!--
    Downloadable Fonts provider certificates for com.google.android.gms.fonts.
    The two string-arrays below MUST be replaced with the exact values Android
    Studio generates for the Downloadable Fonts wizard. The placeholder items are
    not valid certificates: until they are replaced, font verification fails and
    the UI falls back to the system font (no crash).
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>

    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item>REPLACE_WITH_STUDIO_GENERATED_GMS_FONTS_CERT_DEV</item>
    </string-array>

    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item>REPLACE_WITH_STUDIO_GENERATED_GMS_FONTS_CERT_PROD</item>
    </string-array>
</resources>
